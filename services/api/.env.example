# ─────────────────────────────────────────────────────────────────────────────
# Greencore API — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# Variable NAMES are safe to commit; placeholder VALUES are not.
# ─────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://greencore:greencore_dev@localhost:5432/greencore

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=<generate-with-openssl-rand-hex-32-never-commit>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Object storage (S3-compatible)
S3_BUCKET=greencore-uploads
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=<secret>
S3_SECRET_ACCESS_KEY=<secret>
S3_ENDPOINT_URL=<leave blank for AWS; set for Cloudflare R2 or Supabase Storage>

# Mapping / routing provider — [CONFIRM per Section 12 Q1]
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=<secret>
ROUTE_OPTIMIZATION_PROVIDER=google_cloud_fleet_routing

# Push notifications — mount the JSON file, don't paste it here
FCM_SERVICE_ACCOUNT_JSON_PATH=<absolute-path-to-service-account.json>

# Location tracking — [CONFIRM per Section 12 Q3 and Q7]
LOCATION_PING_INTERVAL_SECONDS=20
LOCATION_DATA_RETENTION_DAYS=90

# App environment
ENVIRONMENT=development
LOG_LEVEL=info

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
